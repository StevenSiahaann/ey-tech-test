# ============================================================================
# Conversational BI Agent Environment Configuration
# ============================================================================

# Application
APP_NAME="Conversational BI / Data Agent"
APP_ENV="development"
APP_TIMEZONE="Asia/Jakarta"
AS_OF_DATE="2026-10-29"

# LLM Provider Configuration ('gemini' or 'azure_openai')
LLM_PROVIDER="gemini"

# Gemini Settings
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"

# Azure OpenAI Settings (If using Azure cloud)
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_API_KEY="your-azure-api-key"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# PostgreSQL Database
DATABASE_URL_RO="postgresql://bi_readonly:bi_readonly_secure_password@localhost:5432/ey_bi"
DATABASE_URL_ADMIN="postgresql://postgres:postgrespassword@localhost:5432/ey_bi"

# Redis Cache & Sessions (Pure Redis commands - Azure Cache for Redis compatible)
REDIS_URL="redis://localhost:6379/0"
SESSION_TTL_SECONDS=86400

# Vector Database / Semantic Retrieval Store (Optional)
VECTOR_ENABLED="false"
VECTOR_DB_URI="http://localhost:19530"

# Langfuse Observability & Tracing
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# Limits & Guardrails
MAX_ROWS=1000
SQL_TIMEOUT_MS=10000
MAX_SQL_RETRIES=2
